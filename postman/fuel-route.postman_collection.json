{
  "info": {
    "name": "Fuel Route Planner",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Spotter backend assessment. Set baseUrl if the server is not on localhost:8000."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Cross-country: New York → Los Angeles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=New York, NY&finish=Los Angeles, CA&include_geometry=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "include_geometry",
              "value": "false"
            }
          ]
        },
        "description": "Six stops on I-80/I-70/I-15. Run it twice: the second call reports external_api_calls = 0 (route cache)."
      },
      "response": []
    },
    {
      "name": "Chicago → Dallas (POST JSON)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ]
        },
        "description": "Same API, JSON body. Includes route geometry as GeoJSON.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Dallas, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Pure cheapest fuel (stop_cost_usd=0)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=Chicago, IL&finish=Dallas, TX&stop_cost_usd=0&include_geometry=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            },
            {
              "key": "stop_cost_usd",
              "value": "0"
            },
            {
              "key": "include_geometry",
              "value": "false"
            }
          ]
        },
        "description": "Compare with the default: 11 stops instead of 2, about $24 cheaper. A quarter-gallon top-up shows why stop cost matters."
      },
      "response": []
    },
    {
      "name": "Full tank at the start",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=Chicago, IL&finish=Dallas, TX&start_fuel_percent=100&include_geometry=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "Chicago, IL"
            },
            {
              "key": "finish",
              "value": "Dallas, TX"
            },
            {
              "key": "start_fuel_percent",
              "value": "100"
            },
            {
              "key": "include_geometry",
              "value": "false"
            }
          ]
        },
        "description": "Leaves full: one stop, and the total covers only fuel bought on the way."
      },
      "response": []
    },
    {
      "name": "Coordinates + half tank",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=47.6062,-122.3321&finish=25.7617,-80.1918&start_fuel_percent=50&include_geometry=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "47.6062,-122.3321"
            },
            {
              "key": "finish",
              "value": "25.7617,-80.1918"
            },
            {
              "key": "start_fuel_percent",
              "value": "50"
            },
            {
              "key": "include_geometry",
              "value": "false"
            }
          ]
        },
        "description": "Seattle to Miami from raw coordinates, leaving with half a tank (the total then covers only fuel bought on the way)."
      },
      "response": []
    },
    {
      "name": "Street address (one geocoding call)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=233 S Wacker Dr, Chicago, IL 60606&finish=Denver, CO&include_geometry=false",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "233 S Wacker Dr, Chicago, IL 60606"
            },
            {
              "key": "finish",
              "value": "Denver, CO"
            },
            {
              "key": "include_geometry",
              "value": "false"
            }
          ]
        },
        "description": "A street address costs one Nominatim call; meta shows nominatim.search + osrm.route."
      },
      "response": []
    },
    {
      "name": "Map view",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/map/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            "map"
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        },
        "description": "HTML map; open in a browser or Postman's Preview tab."
      },
      "response": []
    },
    {
      "name": "Error: outside the USA",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=Toronto, ON&finish=Chicago, IL",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "Toronto, ON"
            },
            {
              "key": "finish",
              "value": "Chicago, IL"
            }
          ]
        },
        "description": "400"
      },
      "response": []
    }
  ]
}